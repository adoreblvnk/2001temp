@startuml ssd_06
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam sequence {
    ParticipantBorderColor #1E3A8A
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #1E3A8A
    LifeLineBackgroundColor #FFFFFF
    ArrowColor #1E3A8A
    ActorBorderColor #1E3A8A
    ActorBackgroundColor #EFF6FF
}

title SSD-06 : Handle Emergency Absence Substitute

actor Manager
participant ":AllocationUI" as AllocationUI
participant ":AllocationController" as AllocationController
participant ":ConflictValidator" as ConflictValidator
participant ":Lesson" as Lesson
participant ":Teacher" as AbsentTeacher
participant ":Teacher" as SubstituteTeacher
participant ":AuditLog" as AuditLog

Manager -> AllocationUI : reportAbsence(teacherId, absenceDate, reason)
activate AllocationUI
AllocationUI -> AllocationController : handleEmergencySubstitute(teacherId, absenceDate)
activate AllocationController

AllocationController -> Lesson : getLessonsForTeacher(teacherId, absenceDate)
activate Lesson
Lesson --> AllocationController : List<Lesson>
deactivate Lesson

== Auto-compute eligible substitutes for each lesson ==

loop for each confirmed lesson
    AllocationController -> ConflictValidator : findEligibleCandidates(instrument, weekId)
    activate ConflictValidator
    ConflictValidator --> AllocationController : List<Teacher> (certified, available, <= 44.0h)
    deactivate ConflictValidator
end

AllocationController --> AllocationUI : LessonList (with pre-computed candidates)
deactivate AllocationController
AllocationUI --> Manager : AbsenceView (lessons + candidate lists)
deactivate AllocationUI

== Manager selects substitutes ==

loop for each confirmed lesson
    alt substitute available
        Manager -> AllocationUI : selectSubstitute(lessonId, substituteId)
        activate AllocationUI
        AllocationUI -> AllocationController : reallocateLesson(lessonId, substituteId)
        activate AllocationController
        AllocationController -> Lesson : assignTeacher(substituteTeacher)
        activate Lesson
        Lesson --> AllocationController : Boolean
        deactivate Lesson
        AllocationController -> AbsentTeacher : calculateWeeklyWorkload()
        activate AbsentTeacher
        AbsentTeacher --> AllocationController : float
        deactivate AbsentTeacher
        AllocationController -> SubstituteTeacher : calculateWeeklyWorkload()
        activate SubstituteTeacher
        SubstituteTeacher --> AllocationController : float
        deactivate SubstituteTeacher
        AllocationController -> Lesson : transitionStatus(Confirmed)
        activate Lesson
        Lesson --> AllocationController : Boolean
        deactivate Lesson
        AllocationController -> AuditLog : logAction(managerId, "EMERGENCY_SUBSTITUTE", "Substitute assigned: " + lessonId)
        activate AuditLog
        deactivate AuditLog
        AllocationController --> AllocationUI : AssignmentResult
        AllocationUI --> Manager : ConfirmationView
    else no substitute available
        AllocationUI --> Manager : NoEligibleSubstitutesView

        Manager -> AllocationUI : cancelWithCredit(lessonId)
        AllocationUI -> AllocationController : cancelAllocation(lessonId)
        AllocationController -> Lesson : transitionStatus(Cancelled)
        activate Lesson
        Lesson --> AllocationController : Boolean
        deactivate Lesson
        AllocationController -> AbsentTeacher : calculateWeeklyWorkload()
        activate AbsentTeacher
        AbsentTeacher --> AllocationController : float
        deactivate AbsentTeacher
        AllocationController -> AuditLog : logAction(managerId, "EMERGENCY_CANCEL", "Lesson cancelled: " + lessonId)
        activate AuditLog
        deactivate AuditLog
        AllocationController --> AllocationUI : CancellationResult
        AllocationUI --> Manager : ConfirmationView
    end

    deactivate AllocationController
    deactivate AllocationUI
end

Manager -> AllocationUI : finalizeAbsenceResolution()
activate AllocationUI
AllocationUI -> AllocationController : confirmBatchResolution(teacherId, absenceDate)
activate AllocationController
AllocationController --> AllocationUI : BatchComplete
deactivate AllocationController
AllocationUI --> Manager : EmergencyAbsenceResolved
deactivate AllocationUI

@enduml
