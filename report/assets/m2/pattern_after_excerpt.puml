@startuml pattern_after_excerpt
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.5
}
skinparam interface {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.5
}
skinparam arrow {
    Color #1E3A8A
    FontSize 10
}

class AllocationController <<Control>> {
    - validator : IConflictValidator
    - tieBreaker : ITieBreakerStrategy
    + setTieBreakerStrategy(strategy : ITieBreakerStrategy) : void
    + evaluateCandidates(lessonId : String, mode : RankingStrategy) : List<CandidateEvaluation>
    + allocateLessonSlot(lessonId : String, tId : String, sId : String, slot : TimeSlot, override : Boolean, justif : String) : AllocationResult
}
interface ITieBreakerStrategy <<interface>> {
    + rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
}

class WorkloadDeficitStrategy {
    + rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
}

class PreferenceMatchStrategy {
    + rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
}

class Teacher <<Entity>> {
    - weeklyHours : float
    - monthlyHours : float
    - assignedLocation : String
    + getWeeklyHours() : float
    + getAssignedLocation() : String
    + getAvailability(month : YearMonth) : Availability
}
AllocationController o-down-> ITieBreakerStrategy : ranks via >
WorkloadDeficitStrategy .up.|> ITieBreakerStrategy : <<implements>>
PreferenceMatchStrategy .up.|> ITieBreakerStrategy : <<implements>>
ITieBreakerStrategy .right.> Teacher : orders

@enduml
