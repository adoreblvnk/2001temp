@startuml pattern_after_excerpt
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.5
}
skinparam interface {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.5
}
skinparam arrow {
    Color #1E3A8A
    FontSize 10
}

title Detailed Design - After Strategy Pattern Implementation

class AllocationController <<Control>> {
    - validator : IConflictValidator
    - tieBreakerStrategy : ITieBreakerStrategy
    + setTieBreakerStrategy(strategy : ITieBreakerStrategy) : void
    + allocateLessonSlot(lessonId : String, teacherId : String, studioId : String, slot : TimeSlot) : Boolean
    + getRankedCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
}

interface ITieBreakerStrategy <<interface>> {
    + rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
}

class WorkloadDeficitStrategy {
    + rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
}

class PreferenceMatchStrategy {
    + rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
}

class Teacher <<Entity>> {
    - weeklyHoursTarget : float
    - runningWeeklyHours : float
    + getRunningWeeklyHours() : float
    + getRunningMonthlyHours() : float
}

AllocationController o-> ITieBreakerStrategy : injects strategy >
WorkloadDeficitStrategy .up.|> ITieBreakerStrategy : <<implements>>
PreferenceMatchStrategy .up.|> ITieBreakerStrategy : <<implements>>
ITieBreakerStrategy ..> Teacher : orders

@enduml
