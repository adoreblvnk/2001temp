@startuml component_diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 10
skinparam nodesep 105
skinparam ranksep 46

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.5
    FontSize 10
    FontStyle bold
}

skinparam interface {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    FontSize 10
    FontStyle bold
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.3
    FontSize 11
    FontStyle bold
}

skinparam frame {
    BackgroundColor #FFFFFF
    BorderColor #0F172A
    BorderThickness 1.8
    FontSize 12
    FontStyle bold
}

skinparam arrow {
    Color #1E293B
    Thickness 1.2
    FontSize 9
}

frame "System Boundary: Music School Scheduling System" as SysBoundary {

    package "Presentation Layer" as PkgUI {
        component [WebClientUI] as UI <<subsystem>>
    }

    ' Provided Service Interfaces exposed to Presentation Layer
    () "IAuditLogService" as IAudit
    () "IScheduleService" as ISchedule
    () "IFacultyService" as IFaculty
    () "IFacilityService" as IFacility

    package "Business & Application Layer" as PkgBiz {
        ' Row 1: Domain & Application Services
        component [AuditLoggingService] as AuditComp <<component>>
        component [SchedulingService] as SchedComp <<component>>
        component [FacultyService] as FacComp <<component>>
        component [FacilityService] as FacilComp <<component>>

        ' Internal Business Interfaces
        () "ITieBreakerStrategy" as IRank
        () "IConflictValidator" as IVal

        ' Row 2: Ranking & Multi-Constraint Validation Components
        component [TieBreakerStrategy] as RankComp <<component>>
        component [ConflictValidationService] as ValComp <<component>>
    }

    () "IPersistenceGateway" as IData

    package "Data & Infrastructure Layer" as PkgData {
        component [PersistenceService] as DataComp <<component>>
    }

    portout "pExtNotify" as pExtNotify
}

' External System outside System Boundary
() "INotificationGateway" as INotify
component [ExternalNotificationGateway] as ExtNotify <<external system>>

' Presentation to Provided Business Interfaces (Solid Required Sockets)
UI -down-( IAudit
UI -down-( ISchedule
UI -down-( IFaculty
UI -down-( IFacility

' Service Interface Realizations (Provided Lollipops)
AuditComp -up- IAudit
SchedComp -up- ISchedule
FacComp -up- IFaculty
FacilComp -up- IFacility

' Intra-Layer Business Collaborations (Solid UML 2.5 Assembly Sockets)
SchedComp -up-( IAudit
SchedComp -up-( IFaculty
SchedComp -down-( IRank
SchedComp -down-( IVal
RankComp -up- IRank
ValComp -up- IVal
ValComp -up-( IFaculty
ValComp -up-( IFacility

' Data Layer Persistence Realization & Consumers
DataComp -up- IData
AuditComp -down-( IData
SchedComp -down-( IData
FacComp -down-( IData
FacilComp -down-( IData

' UML 2.5.1 Boundary Delegation (solid line, no arrowhead) & External Socket/Lollipop
SchedComp -- pExtNotify : <<delegate>>
pExtNotify -down-( INotify
ExtNotify -up- INotify

' Strict Horizontal & Vertical Layout Ordering
IAudit -[hidden]right-> ISchedule
ISchedule -[hidden]right-> IFaculty
IFaculty -[hidden]right-> IFacility

AuditComp -[hidden]right-> SchedComp
SchedComp -[hidden]right-> FacComp
FacComp -[hidden]right-> FacilComp

SchedComp -[hidden]down-> IRank
FacComp -[hidden]down-> IVal
IRank -[hidden]right-> IVal
RankComp -[hidden]right-> ValComp

RankComp -[hidden]down-> IData
ValComp -[hidden]down-> IData
IData -[hidden]down-> DataComp

@enduml
