@startuml component_diagram
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.5
    HeaderBackgroundColor #EFF6FF
    FontSize 12
    FontStyle bold
}

skinparam interface {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    FontSize 10
    FontStyle bold
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.2
    FontSize 12
    FontStyle bold
}

skinparam note {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontSize 10
}

' ==============================================================
' BOUNDARY / PRESENTATION SUBSYSTEM
' ==============================================================
package "Presentation Layer (Web / Desktop Boundary)" {
    component [PresentationComponent] as Presentation <<subsystem>> {
        note as N_UI
            Boundaries:
            * AllocationUI
            * ManagerDashboardUI
            * TeacherUI
            * AdminUI
            * AuditLogUI
        end note
    }
}

' ==============================================================
' APPLICATION & BUSINESS CONTROL SUBSYSTEMS
' ==============================================================
package "Core Business Logic & Control Subsystems" {

    component [SchedulingComponent] as Scheduling <<component>> {
        note as N_Sched
            Controllers:
            * AllocationController
            * ScheduleController
            * RejectionController
        end note
    }

    component [ValidationComponent] as Validation <<component>> {
        note as N_Val
            Domain Service:
            * ConflictValidator
        end note
    }

    component [FacultyComponent] as Faculty <<component>> {
        note as N_Fac
            Controllers:
            * AvailabilityController
            * PreferenceController
            * WorkloadController
        end note
    }

    component [FacilityComponent] as Facility <<component>> {
        note as N_Facil
            Controllers:
            * StudioController
            * ReportController
        end note
    }

    component [AuditComplianceComponent] as AuditComp <<component>> {
        note as N_Audit
            Controllers:
            * AuditLogController
            * ComplianceController
        end note
    }

    component [RankingStrategyComponent] as Ranking <<component>> {
        note as N_Rank
            Strategies:
            * WorkloadDeficitStrategy
            * PreferenceMatchStrategy
        end note
    }
}

' ==============================================================
' EXTERNAL INTEGRATION / INFRASTRUCTURE SUBSYSTEM
' ==============================================================
package "Infrastructure & External Gateways" {
    component [NotificationComponent] as Notification <<gateway>> {
        note as N_Notify
            Adapter:
            * NotificationGatewayAdapter
        end note
    }

    component [PersistenceComponent] as Persistence <<gateway>> {
        note as N_DB
            Repository & Data Mapper:
            * DatabaseGateway
        end note
    }
}

' ==============================================================
' PROVIDED INTERFACES (Lollipops)
' ==============================================================
() "IScheduleService" as IScheduleService
() "IConflictValidator" as IConflictValidator
() "IFacultyService" as IFacultyService
() "IFacilityService" as IFacilityService
() "IAuditLogService" as IAuditLogService
() "IComplianceService" as IComplianceService
() "ITieBreakerStrategy" as ITieBreakerStrategy
() "INotificationGateway" as INotificationGateway
() "IPersistenceGateway" as IPersistenceGateway

' Realization of Provided Interfaces (Component -> Lollipop)
Scheduling -up- IScheduleService
Validation -up- IConflictValidator
Faculty -up- IFacultyService
Facility -up- IFacilityService
AuditComp -up- IAuditLogService
AuditComp -right- IComplianceService
Ranking -up- ITieBreakerStrategy
Notification -up- INotificationGateway
Persistence -up- IPersistenceGateway

' ==============================================================
' REQUIRED INTERFACES (Sockets / Invocations)
' ==============================================================
' Presentation layer dependencies
Presentation ..( IScheduleService : requires
Presentation ..( IFacultyService : requires
Presentation ..( IFacilityService : requires
Presentation ..( IAuditLogService : requires
Presentation ..( IComplianceService : requires

' SchedulingComponent dependencies
Scheduling ..( IConflictValidator : requires
Scheduling ..( ITieBreakerStrategy : requires
Scheduling ..( INotificationGateway : requires
Scheduling ..( IAuditLogService : requires
Scheduling ..( IFacultyService : requires

' ValidationComponent dependencies
Validation ..( IFacultyService : requires
Validation ..( IFacilityService : requires

' Faculty and Facility audit dependencies
Faculty ..( IAuditLogService : requires
Facility ..( IAuditLogService : requires

' Persistence dependencies
Scheduling ..( IPersistenceGateway : requires
Faculty ..( IPersistenceGateway : requires
Facility ..( IPersistenceGateway : requires
AuditComp ..( IPersistenceGateway : requires

@enduml