@startuml component_diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 10
skinparam linetype ortho

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.5
    HeaderBackgroundColor #EFF6FF
    FontSize 10
    FontStyle bold
}

skinparam interface {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    FontSize 10
    FontStyle bold
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.2
    FontSize 11
    FontStyle bold
}

skinparam frame {
    BackgroundColor #FFFFFF
    BorderColor #0F172A
    BorderThickness 1.8
    FontSize 12
    FontStyle bold
}

frame "System Boundary: Music School Scheduling System" {

    package "Presentation Layer" {
        component [WebClientUI] as UI <<subsystem>>
    }

    ' Service Interfaces
    () "IScheduleService" as ISchedule
    () "IFacultyService" as IFaculty
    () "IFacilityService" as IFacility
    () "IAuditLogService" as IAudit

    package "Business & Application Layer (Core Scheduling Services)" {
        component [SchedulingService] as SchedComp <<component>>
        component [ConflictValidationService] as ValComp <<component>>
        component [TieBreakerStrategy] as RankComp <<component>>
    }

    ' Internal Business Interfaces
    () "IConflictValidator" as IVal
    () "ITieBreakerStrategy" as IRank

    package "Business & Application Layer (Faculty, Facilities & Audit)" {
        component [FacultyService] as FacComp <<component>>
        component [FacilityService] as FacilComp <<component>>
        component [AuditLoggingService] as AuditComp <<component>>
    }

    ' Persistence Interface
    () "IPersistenceGateway" as IData

    package "Data & Infrastructure Layer" {
        component [PersistenceService] as DataComp <<component>>
    }

    port "pExtNotify" as pExtNotify
}

' External System
component [ExternalNotificationGateway] as ExtNotify <<external system>>

' Presentation to Service Interfaces
UI -( ISchedule
UI -( IFaculty
UI -( IFacility
UI -( IAudit

' Service Realizations
SchedComp -up- ISchedule
FacComp -up- IFaculty
FacilComp -up- IFacility
AuditComp -up- IAudit

' Internal Business Wiring
SchedComp -( IVal
SchedComp -( IRank
ValComp -up- IVal
RankComp -up- IRank

' Data Tier Realization and Requirements
SchedComp -( IData
FacComp -( IData
FacilComp -( IData
AuditComp -( IData
DataComp -up- IData

' External Notification Port Connection
() "INotificationGateway" as INotify
AuditComp -down- INotify
pExtNotify -up-( INotify
pExtNotify -down- ExtNotify

' Vertical Alignment Constraints
UI -[hidden]down-> ISchedule
ISchedule -[hidden]down-> SchedComp
SchedComp -[hidden]down-> FacComp
FacComp -[hidden]down-> IData
IData -[hidden]down-> DataComp

@enduml
