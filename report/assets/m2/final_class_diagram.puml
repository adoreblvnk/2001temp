@startuml final_class_diagram
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 10
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.5
}
skinparam arrow {
    Color #1E3A8A
    FontSize 9
}
skinparam interface {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.5
}
skinparam package {
    BorderColor #94A3B8
    FontStyle bold
    FontSize 11
}

' Group 1: Presentation Layer (Boundaries)
package "Presentation Layer (Boundaries)" {
    class AllocationUI <<Boundary>> {
        +renderCandidateComparison() : void
        +showValidationError(error : String) : void
    }
    class ManagerDashboardUI <<Boundary>> {
        +displayWorkloadMetrics() : void
        +highlightOutliers() : void
    }
    class TeacherUI <<Boundary>> {
        +renderSchedule() : void
        +renderAvailabilityGrid() : void
    }
    class AdminUI <<Boundary>> {
        +renderUserManagementConsole() : void
        +renderStudioConfigPanel() : void
    }
}

' Group 2: Service Interfaces
package "Service Interfaces" {
    interface IScheduleService <<interface>> {
        +allocateLessonSlot(lessonId, teacherId, studioId, slot) : Boolean
        +reallocateLesson(lessonId, substituteTeacherId) : Boolean
        +notifyAssignedTeachers(weekId) : Boolean
    }
    interface IConflictValidator <<interface>> {
        +validateAllocationRules(teacher, studio, slot) : ValidationResult
        +findEligibleCandidates(instrument, slot, weekId) : List<Teacher>
        +checkContinuousTeachingLimit(teacher, slot) : Boolean
    }
    interface IFacultyService <<interface>> {
        +submitAvailability(teacherId, month, slots) : Boolean
        +getLowestWorkloadStaff() : List<Teacher>
    }
    interface IAuditLogService <<interface>> {
        +recordAuditEntry(actorId, action, details) : Boolean
        +queryAuditLogs(weekId) : List<AuditLog>
    }
}

' Group 3: Application Controllers
package "Application & Control Layer" {
    class AllocationController <<Control>> {
        -validator : IConflictValidator
        -tieBreaker : ITieBreakerStrategy
        -auditService : IAuditLogService
        +allocateLessonSlot(lessonId, teacherId, studioId, slot) : Boolean
        +reallocateLesson(lessonId, substituteTeacherId) : Boolean
    }
    class ConflictValidator <<Control>> {
        +validateAllocationRules(teacher, studio, slot) : ValidationResult
        +findEligibleCandidates(instrument, slot, weekId) : List<Teacher>
    }
    class FacultyController <<Control>> {
        +submitAvailability(teacherId, month, slots) : Boolean
        +getLowestWorkloadStaff() : List<Teacher>
    }
    class AuditLogController <<Control>> {
        +recordAuditEntry(actorId, action, details) : Boolean
        +queryAuditLogs(weekId) : List<AuditLog>
    }
}

' Group 4: Design Patterns (Strategy)
package "Design Pattern Realizations" {
    interface ITieBreakerStrategy <<interface>> {
        +rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
    }
    class WorkloadDeficitStrategy {
        +rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
    }
    class PreferenceMatchStrategy {
        +rankCandidates(candidates : List<Teacher>, slot : TimeSlot) : List<Teacher>
    }
}

' Group 5: Domain Entities
package "Domain Entities (Data Tier)" {
    abstract class User <<Entity>> {
        - staffId : String
        - fullName : String
        - email : String
    }
    class Teacher <<Entity>> {
        - instrumentQualifications : List<InstrumentType>
        - weeklyHours : float
        - monthlyHours : float
        - assignedLocation : String
        + getWeeklyHours() : float
        + getAssignedLocation() : String
    }
    class Lesson <<Entity>> {
        - lessonId : String
        - studentName : String
        - status : LessonStatus
    }
    class Studio <<Entity>> {
        - studioId : String
        - hasDrumKit : Boolean
    }
    class AuditLog <<Entity>> {
        - logId : String
        - actionType : String
        - timestamp : DateTime
    }
}

' Realizations
AllocationController .up.|> IScheduleService
ConflictValidator .up.|> IConflictValidator
FacultyController .up.|> IFacultyService
AuditLogController .up.|> IAuditLogService
WorkloadDeficitStrategy .up.|> ITieBreakerStrategy
PreferenceMatchStrategy .up.|> ITieBreakerStrategy

' Boundary Invocations
AllocationUI ..> IScheduleService : invokes
ManagerDashboardUI ..> IFacultyService : invokes
TeacherUI ..> IFacultyService : invokes
AdminUI ..> IAuditLogService : invokes

' Delegations
AllocationController --> IConflictValidator : validates via
AllocationController --> ITieBreakerStrategy : ranks via
AllocationController --> IAuditLogService : audits via

' Entity relationships
User <|-- Teacher
Lesson "0..*" --> "0..1" Teacher : assignedTo >
Lesson "0..*" --> "0..1" Studio : conductedIn >
AuditLog "0..*" --> "0..1" Lesson : records >

' Vertical order constraints
AllocationUI -[hidden]down-> IScheduleService
IScheduleService -[hidden]down-> AllocationController
AllocationController -[hidden]down-> ITieBreakerStrategy
ITieBreakerStrategy -[hidden]down-> User

@enduml
