@startuml final_class_diagram_services
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 10
skinparam nodesep 22
skinparam ranksep 26
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.5
}
skinparam arrow {
    Color #1E3A8A
    FontSize 9
}
skinparam interface {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.5
}
skinparam package {
    BorderColor #94A3B8
    FontStyle bold
    FontSize 11
}

package "Presentation Layer (Boundaries)" {
    together {
        class AllocationUI <<Boundary>> {
            +renderCandidateComparison(lessonId : String, sId : String, mode : RankingStrategy) : void
            +renderRejectedLessonQueue(wk : String) : void
            +promptOvertimeConfirmation(res : AllocationResult) : Boolean
        }
        class ManagerDashboardUI <<Boundary>> {
            +displayWorkloadMetrics(wk : String) : void
            +displayStudioUtilisation(wk : String, basis : PeriodBasis, asOf : DateTime) : void
            +confirmWeeklySchedule(wk : String) : void
            +exportUtilisationPdf() : void
        }
        class AuditLogUI <<Boundary>> {
            +renderAuditTrail() : void
            +filterLogs(q : String, actorId : String, act : AuditAction) : void
            +exportAuditPdf() : void
        }
    }
    together {
        class TeacherUI <<Boundary>> {
            +renderWeeklySchedule(tId : String, wk : String) : void
            +renderAvailabilityGrid(tId : String, month : YearMonth) : void
            +submitRejectionDialog(lessonId : String, rsn : RejectionReason, note : String) : void
        }
        class AdminUI <<Boundary>> {
            +renderUserManagementConsole() : void
            +renderStudioMaintenancePanel(wk : String) : void
        }
    }
    AllocationUI -[hidden]right-> ManagerDashboardUI
    ManagerDashboardUI -[hidden]right-> AuditLogUI
    AllocationUI -[hidden]down-> TeacherUI
    ManagerDashboardUI -[hidden]down-> AdminUI
}

package "Business & Application Layer" {
    together {
        interface IScheduleService <<interface>> {
            +allocateLessonSlot(lessonId : String, tId : String, sId : String, slot : TimeSlot, override : Boolean, justif : String) : AllocationResult
            +evaluateCandidates(lessonId : String, sId : String, mode : RankingStrategy) : List<CandidateEvaluation>
            +releaseLessonSlot(lessonId : String) : Boolean
            +requestJobRejection(lessonId : String, rsn : RejectionReason, note : String) : Boolean
            +resolveJobRejection(lessonId : String, retain : Boolean) : Boolean
            +notifyAssignedTeachers(wk : String) : Boolean
            +getWeeklyLessons(wk : String) : List<Lesson>
            +getTeacherSchedule(tId : String, wk : String) : List<Lesson>
            +getPendingRejections(wk : String) : List<Lesson>
        }
        interface IConflictValidator <<interface>> {
            +validateAllocationRules(lesson : Lesson, t : Teacher, s : Studio, slot : TimeSlot) : ValidationResult
            +findEligibleCandidates(inst : InstrumentType, slot : TimeSlot, wk : String) : List<Teacher>
            +checkContinuousTeachingLimit(t : Teacher, slot : TimeSlot) : Boolean
        }
    }
    together {
        class AllocationController <<Control>> {
            -validator : IConflictValidator
            -facultyService : IFacultyService
            -facilityService : IFacilityService
            -tieBreaker : ITieBreakerStrategy
            -auditService : IAuditLogService
            -persistence : IPersistenceGateway
            -notificationGateway : INotificationGateway
            +setTieBreakerStrategy(strategy : ITieBreakerStrategy) : void
            +evaluateCandidates(lessonId : String, sId : String, mode : RankingStrategy) : List<CandidateEvaluation>
            +allocateLessonSlot(lessonId : String, tId : String, sId : String, slot : TimeSlot, override : Boolean, justif : String) : AllocationResult
            +releaseLessonSlot(lessonId : String) : Boolean
            +requestJobRejection(lessonId : String, rsn : RejectionReason, note : String) : Boolean
            +resolveJobRejection(lessonId : String, retain : Boolean) : Boolean
            +notifyAssignedTeachers(wk : String) : Boolean
            +getWeeklyLessons(wk : String) : List<Lesson>
            +getTeacherSchedule(tId : String, wk : String) : List<Lesson>
            +getPendingRejections(wk : String) : List<Lesson>
        }
        class ConflictValidator <<Control>> {
            -facultyService : IFacultyService
            -facilityService : IFacilityService
            +validateAllocationRules(lesson : Lesson, t : Teacher, s : Studio, slot : TimeSlot) : ValidationResult
            +findEligibleCandidates(inst : InstrumentType, slot : TimeSlot, wk : String) : List<Teacher>
            +checkContinuousTeachingLimit(t : Teacher, slot : TimeSlot) : Boolean
            -workloadTier(proj : float) : WorkloadTier
        }
    }
    together {
        interface IFacultyService <<interface>> {
            +submitAvailability(tId : String, month : YearMonth, slots : Set<TimeSlot>, prefDays : Set<DayOfWeek>, prefStudio : String) : Boolean
            +getAvailability(tId : String, month : YearMonth) : Availability
            +getLowestWorkloadStaff(wk : String) : List<Teacher>
            +getActiveTeachers() : List<Teacher>
            +getTeacher(tId : String) : Teacher
            +getAllUsers() : List<User>
            +provisionAccount(id : String, name : String, email : String, phone : String, role : Role, certs : Set<InstrumentType>, sId : String) : User
            +setAccountActiveStatus(id : String, active : Boolean) : Boolean
        }
        interface IFacilityService <<interface>> {
            +configureStudio(sId : String, name : String, equipped : Set<InstrumentType>) : Boolean
            +flagMaintenanceWindow(sId : String, wk : String, start : DateTime, end : DateTime, rsn : String) : MaintenanceWindow
            +removeMaintenanceWindow(windowId : String) : Boolean
            +getStudio(sId : String) : Studio
            +getAllStudios() : List<Studio>
            +getMaintenanceWindows(wk : String) : List<MaintenanceWindow>
            +getStudioUtilisation(wk : String, basis : PeriodBasis, asOf : DateTime) : List<StudioUtilisationReport>
        }
        interface IAuditLogService <<interface>> {
            +recordAuditEntry(actorId : String, role : Role, act : AuditAction, target : String, details : String) : AuditLog
            +queryAuditLogs(q : String, actorId : String, act : AuditAction) : List<AuditLog>
        }
    }
    together {
        class FacultyController <<Control>> {
            -auditService : IAuditLogService
            -persistence : IPersistenceGateway
            +submitAvailability(tId : String, month : YearMonth, slots : Set<TimeSlot>, prefDays : Set<DayOfWeek>, prefStudio : String) : Boolean
            +getAvailability(tId : String, month : YearMonth) : Availability
            +getLowestWorkloadStaff(wk : String) : List<Teacher>
            +getActiveTeachers() : List<Teacher>
            +getTeacher(tId : String) : Teacher
            +getAllUsers() : List<User>
            +provisionAccount(id : String, name : String, email : String, phone : String, role : Role, certs : Set<InstrumentType>, sId : String) : User
            +setAccountActiveStatus(id : String, active : Boolean) : Boolean
        }
        class FacilityController <<Control>> {
            -auditService : IAuditLogService
            -persistence : IPersistenceGateway
            +configureStudio(sId : String, name : String, equipped : Set<InstrumentType>) : Boolean
            +flagMaintenanceWindow(sId : String, wk : String, start : DateTime, end : DateTime, rsn : String) : MaintenanceWindow
            +removeMaintenanceWindow(windowId : String) : Boolean
            +getStudio(sId : String) : Studio
            +getAllStudios() : List<Studio>
            +getMaintenanceWindows(wk : String) : List<MaintenanceWindow>
            +getStudioUtilisation(wk : String, basis : PeriodBasis, asOf : DateTime) : List<StudioUtilisationReport>
        }
        class AuditLogController <<Control>> {
            -persistence : IPersistenceGateway
            +recordAuditEntry(actorId : String, role : Role, act : AuditAction, target : String, details : String) : AuditLog
            +queryAuditLogs(q : String, actorId : String, act : AuditAction) : List<AuditLog>
        }
    }
}

package "Design Pattern Realization (GoF Strategy)" {
    interface ITieBreakerStrategy <<interface>> {
        +rankCandidates(candidates : List<Teacher>, slot : TimeSlot, sId : String) : List<Teacher>
    }
    class WorkloadDeficitStrategy {
        +rankCandidates(candidates : List<Teacher>, slot : TimeSlot, sId : String) : List<Teacher>
    }
    class PreferenceMatchStrategy {
        +rankCandidates(candidates : List<Teacher>, slot : TimeSlot, sId : String) : List<Teacher>
    }
}

package "Data & Infrastructure Layer Contracts" {
    interface IPersistenceGateway <<interface>> {
        +findConfirmedLessonsBefore(wk : String, basis : PeriodBasis, asOf : DateTime) : List<Lesson>
        +saveEntity<T>(entity : T) : void
    }
    interface INotificationGateway <<interface>> {
        +dispatchScheduleAlert(tId : String, email : String, event : ScheduleEvent) : Boolean
    }
}

' Realizations
AllocationController .up.|> IScheduleService
ConflictValidator .up.|> IConflictValidator
FacultyController .up.|> IFacultyService
FacilityController .up.|> IFacilityService
AuditLogController .up.|> IAuditLogService
WorkloadDeficitStrategy .up.|> ITieBreakerStrategy
PreferenceMatchStrategy .up.|> ITieBreakerStrategy

' Boundary Invocations
AuditLogUI ..> IAuditLogService : invokes
ManagerDashboardUI ..> IScheduleService : invokes
ManagerDashboardUI ..> IFacultyService : invokes
ManagerDashboardUI ..> IFacilityService : invokes
AllocationUI ..> IScheduleService : invokes
AllocationUI ..> IFacilityService : invokes
TeacherUI ..> IScheduleService : invokes
TeacherUI ..> IFacultyService : invokes
AdminUI ..> IFacultyService : invokes
AdminUI ..> IFacilityService : invokes

' Intra-Layer Delegations
AllocationController "1" -[norank]-> "1" IConflictValidator : validates via
AllocationController "1" -down-> "1" IFacultyService : queries
AllocationController "1" -down-> "1" IFacilityService : queries
AllocationController "1" -[norank]-> "1" IAuditLogService : audits via
AllocationController "1" o-down-> "1" ITieBreakerStrategy : ranks via >
ConflictValidator "1" -down-> "1" IFacultyService : queries
ConflictValidator "1" -down-> "1" IFacilityService : queries
FacultyController "1" -[norank]-> "1" IAuditLogService : audits via
FacilityController "1" -[norank]-> "1" IAuditLogService : audits via

' Infrastructure Gateway Delegations
AllocationController .down.> IPersistenceGateway : persists
AllocationController "1" -down-> "1" INotificationGateway : dispatches >
FacultyController .down.> IPersistenceGateway : persists
FacilityController .down.> IPersistenceGateway : queries lessons & windows
AuditLogController .down.> IPersistenceGateway : persists

' Vertical stacking between subsystem tiers
TeacherUI -[hidden]down-> IScheduleService
AdminUI -[hidden]down-> IConflictValidator
IScheduleService -[hidden]right-> IConflictValidator
AllocationController -[hidden]down-> IFacultyService
ConflictValidator -[hidden]down-> IFacilityService
IFacultyService -[hidden]right-> IFacilityService
IFacilityService -[hidden]right-> IAuditLogService
FacultyController -[hidden]down-> ITieBreakerStrategy
WorkloadDeficitStrategy -[hidden]down-> IPersistenceGateway
PreferenceMatchStrategy -[hidden]down-> INotificationGateway
@enduml
