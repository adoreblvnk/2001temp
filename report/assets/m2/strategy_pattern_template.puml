@startuml strategy_pattern_template
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    BorderThickness 1.5
}
skinparam interface {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.5
}
skinparam arrow {
    Color #1E3A8A
    FontSize 10
}

title Gang of Four (GoF) Strategy Pattern - Structural Template

class Context {
    - strategy : Strategy
    + Context(strategy : Strategy)
    + setStrategy(strategy : Strategy) : void
    + executeContextInterface() : void
}

interface Strategy <<interface>> {
    + executeAlgorithm(data : Object) : Object
}

class ConcreteStrategyA {
    + executeAlgorithm(data : Object) : Object
}

class ConcreteStrategyB {
    + executeAlgorithm(data : Object) : Object
}

Context o-> Strategy : strategy
ConcreteStrategyA .up.|> Strategy : <<implements>>
ConcreteStrategyB .up.|> Strategy : <<implements>>

@enduml
