@startuml architecture_diagram
top to bottom direction
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #1E3A8A
    BorderThickness 1.5
    FontSize 12
    FontStyle bold
}

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.2
    FontSize 11
}

skinparam arrow {
    Color #1E3A8A
    FontSize 10
}

package "Presentation Layer (Web Boundary)" as Layer1 {
    class "AllocationUI" as UI1
    class "ManagerDashboardUI" as UI2
    class "TeacherUI" as UI3
    class "AdminUI" as UI4
}

package "Business & Application Layer (Core & Faculty Services)" as Layer2A {
    class "SchedulingService" as S1
    class "ConflictValidationService" as S2
    class "TieBreakerStrategy" as S6
}

package "Business & Application Layer (Facility & Governance Services)" as Layer2B {
    class "FacultyService" as S3
    class "FacilityService" as S4
    class "AuditLoggingService" as S5
}

package "Data & Infrastructure Layer (Closed)" as Layer3 {
    class "Database Persistence (PostgreSQL)" as DB
    class "External Notification Gateway (SMTP/SMS)" as GW
}

Layer1 --> Layer2A : Invocations via Service Interfaces
Layer2A --> Layer2B : Internal Domain Collaboration
Layer2B --> Layer3 : Persistence & Gateway Contracts

Layer1 -[hidden]down-> Layer2A
Layer2A -[hidden]down-> Layer2B
Layer2B -[hidden]down-> Layer3

@enduml
