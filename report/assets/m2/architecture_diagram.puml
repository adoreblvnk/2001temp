@startuml architecture_diagram
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam packageStyle rectangle

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #1E3A8A
    BorderThickness 1.5
    FontSize 12
    FontStyle bold
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.5
    FontSize 11
}

skinparam arrow {
    Color #1E3A8A
    FontSize 10
}

package "Tier 1: Presentation & Boundary Layer (Web / Desktop)" {
    component [Manager Dashboard UI] as UI_Manager
    component [Job Allocation Interface] as UI_Alloc
    component [Teacher Schedule & Availability UI] as UI_Teacher
    component [Admin Facility & User Console] as UI_Admin
    component [Audit Trail Viewer] as UI_Audit
}

package "Tier 2: Business Logic & Control Layer (Domain Services & Application)" {
    component [Scheduling & Allocation Controller] as Ctrl_Alloc
    component [Multi-Constraint Conflict Validator] as Ctrl_Val
    component [Faculty Availability & Workload Controller] as Ctrl_Fac
    component [Facility & Blackout Controller] as Ctrl_Studio
    component [Audit & Regulatory Compliance Controller] as Ctrl_Audit
    component [Candidate Tie-Breaker Strategy Engine] as Ctrl_Strat
}

package "Tier 3: Domain Entity & Infrastructure Integration Layer" {
    package "Core Domain Model (Entities)" {
        component [Schedule & Lesson Entities] as Ent_Sched
        component [User & Teacher Entities] as Ent_Teacher
        component [Studio & Maintenance Entities] as Ent_Studio
        component [Immutable Audit Log Records] as Ent_Audit
    }
    package "External Gateways & Hardware Adapters" {
        component [Database Gateway Adapter (PostgreSQL / SQLite)] as GW_DB
        component [External Notification Gateway (SMTP / SMS)] as GW_Notify
    }
}

' Inter-tier dependencies
UI_Alloc --> Ctrl_Alloc : HTTP/RPC Request
UI_Manager --> Ctrl_Fac : Query Metrics
UI_Teacher --> Ctrl_Fac : Submit Availability
UI_Admin --> Ctrl_Studio : Manage Blackouts
UI_Audit --> Ctrl_Audit : Query Records

Ctrl_Alloc --> Ctrl_Val : Validates Constraints
Ctrl_Alloc --> Ctrl_Strat : Injects Ranking Strategy
Ctrl_Alloc --> Ctrl_Audit : Emits Log Events
Ctrl_Alloc --> GW_Notify : Dispatches Roster Alerts

Ctrl_Alloc --> Ent_Sched : Mutates State
Ctrl_Val --> Ent_Teacher : Checks Workload & Skills
Ctrl_Val --> Ent_Studio : Checks Capacity & Baffling
Ctrl_Audit --> Ent_Audit : Appends Immutable Entry

Ent_Sched --> GW_DB : Persists Records
Ent_Teacher --> GW_DB : Persists Records
Ent_Studio --> GW_DB : Persists Records
Ent_Audit --> GW_DB : Cryptographic Snapshots

@enduml
