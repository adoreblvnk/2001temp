@startuml architecture_diagram
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam nodesep 24
skinparam ranksep 36

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #1E3A8A
    BorderThickness 1.6
    FontSize 12
    FontStyle bold
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.3
    FontSize 11
}

skinparam database {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.3
    FontSize 11
}

skinparam arrow {
    Color #1E3A8A
    Thickness 1.4
    FontSize 10
}

package "1. Presentation Layer (Closed — Web Boundary)" as Layer1 {
    together {
        component "ManagerDashboardUI" as UI1
        component "AllocationUI" as UI2
        component "TeacherUI" as UI3
    }
    together {
        component "AdminUI" as UI4
        component "AuditLogUI" as UI5
    }
    UI1 -[hidden]right-> UI2
    UI2 -[hidden]right-> UI3
    UI4 -[hidden]right-> UI5
    UI1 -[hidden]down-> UI4
    UI2 -[hidden]down-> UI5
}

package "2. Business & Application Layer (Closed — Domain Services & Strategies)" as Layer2 {
    together {
        component "SchedulingService" as S1
        component "ConflictValidationService" as S2
        component "TieBreakerStrategy" as S3
    }
    together {
        component "FacultyService" as S4
        component "FacilityService" as S5
        component "AuditLoggingService" as S6
    }
    S1 -[hidden]right-> S2
    S2 -[hidden]right-> S3
    S4 -[hidden]right-> S5
    S5 -[hidden]right-> S6
    S1 -[hidden]down-> S4
    S2 -[hidden]down-> S5
    S3 -[hidden]down-> S6
}

package "3. Data & Infrastructure Layer (Closed — Persistence & Gateways)" as Layer3 {
    database "PostgreSQL Database\n(PersistenceService)" as DB
    component "ExternalNotificationGateway\n(SMTP / SMS Adapter)" as GW
    DB -[hidden]right-> GW
}
Layer1 -down-> Layer2 : "  Service Interface Invocations\n  (IScheduleService, IFacultyService, IFacilityService, IAuditLogService)"
Layer2 -down-> Layer3 : "  Persistence & Gateway Contracts\n  (IPersistenceGateway, INotificationGateway)"
UI4 -[hidden]down-> S1
S5 -[hidden]down-> DB
@enduml
