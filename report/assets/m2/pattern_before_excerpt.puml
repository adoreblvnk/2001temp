@startuml pattern_before_excerpt
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #B91C1C
    BorderThickness 1.5
}
skinparam arrow {
    Color #B91C1C
    FontSize 10
}

class AllocationController <<Control>> {
    - validator : ConflictValidator
    - rankingMode : RankingStrategy
    + allocateLessonSlot(lessonId : String, tId : String, sId : String, slot : TimeSlot, override : Boolean, justif : String) : AllocationResult
    + rankCandidates(candidates : List<Teacher>, slot : TimeSlot, sId : String, mode : RankingStrategy) : List<Teacher>
}

class Teacher <<Entity>> {
    - weeklyHours : float
    - monthlyHours : float
    - assignedLocation : String
    + getWeeklyHours() : float
    + getAssignedLocation() : String
    + getAvailability(month : YearMonth) : Availability
}
AllocationController "1" --> "0..*" Teacher : directly sorts >

@enduml
