@startuml ssd_14
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam sequence {
    ParticipantBorderColor #1E3A8A
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #1E3A8A
    LifeLineBackgroundColor #FFFFFF
    ArrowColor #1E3A8A
    ActorBorderColor #1E3A8A
    ActorBackgroundColor #EFF6FF
}

title SSD-14 : Configure Studio & Instrument Setup

actor "IT Administrator" as ITAdmin
participant ":AdminUI" as AdminUI
participant ":StudioController" as StudioController
participant ":Studio" as Studio
participant ":ConflictValidator" as ConflictValidator
participant ":AuditLog" as AuditLog

ITAdmin -> AdminUI : accessStudioConfig()
activate ITAdmin
activate AdminUI
AdminUI -> StudioController : getStudioInventory()
activate StudioController
StudioController -> Studio : hasDrumKitInstalled()
activate Studio
Studio --> StudioController : Boolean
deactivate Studio
StudioController --> AdminUI : StudioList
deactivate StudioController
AdminUI --> ITAdmin : StudioRegistryView
deactivate AdminUI


ITAdmin -> AdminUI : configureOperatingHours(hours)
activate AdminUI
AdminUI -> StudioController : configureStudio(studioId, name, hasPiano)
activate StudioController
StudioController -> Studio : isOccupied(timeSlot)
activate Studio
Studio --> StudioController : Boolean
deactivate Studio
StudioController -> ConflictValidator : checkRoomAvailability(studio, timeSlot)
activate ConflictValidator
ConflictValidator --> StudioController : Boolean
deactivate ConflictValidator
StudioController -> AuditLog : logAction(adminId, "CONFIGURE_STUDIO", studioId)
activate AuditLog
deactivate AuditLog
StudioController --> AdminUI : ConfigResult
deactivate StudioController
AdminUI --> ITAdmin : ConfirmationView
deactivate AdminUI

deactivate ITAdmin
@enduml
