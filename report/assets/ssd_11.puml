@startuml ssd_11
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam sequence {
    ParticipantBorderColor #1E3A8A
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #1E3A8A
    LifeLineBackgroundColor #FFFFFF
    ArrowColor #1E3A8A
    ActorBorderColor #1E3A8A
    ActorBackgroundColor #EFF6FF
}

title SSD-11 : Inspect System Audit Log

actor "Manager / IT Administrator" as Staff
participant ":AuditLogUI" as AuditLogUI
participant ":AuditLogController" as AuditLogController
participant ":AuditLog" as AuditLog
participant ":DatabaseGateway" as ExtDB

Staff -> AuditLogUI : navigateToAuditConsole()
activate Staff
activate AuditLogUI

AuditLogUI -> AuditLogController : queryAuditLogs("", "")
activate AuditLogController

AuditLogController -> ExtDB : fetchAuditRecords()
activate ExtDB
ExtDB --> AuditLogController : List<AuditLogRecord>
deactivate ExtDB

AuditLogController --> AuditLogUI : List<AuditLog>
deactivate AuditLogController

AuditLogUI --> Staff : renderAuditLogConsole(records)
deactivate AuditLogUI

Staff -> AuditLogUI : applyFilter(actorFilter, actionFilter)
activate AuditLogUI

AuditLogUI -> AuditLogController : queryAuditLogs(actorFilter, actionFilter)
activate AuditLogController

AuditLogController -> ExtDB : executeFilteredQuery(actorFilter, actionFilter)
activate ExtDB
ExtDB --> AuditLogController : List<AuditLogRecord>
deactivate ExtDB

loop for each record
    AuditLogController -> AuditLog : getTimestamp()
    activate AuditLog
    AuditLog --> AuditLogController : DateTime
    deactivate AuditLog

    AuditLogController -> AuditLog : getActionType()
    activate AuditLog
    AuditLog --> AuditLogController : String
    deactivate AuditLog
end

AuditLogController --> AuditLogUI : filteredLogs
deactivate AuditLogController

AuditLogUI --> Staff : displayFilteredRecords(filteredLogs)
deactivate AuditLogUI

opt Export Audit Trail
    Staff -> AuditLogUI : exportAuditTrail("CSV")
    activate AuditLogUI
    AuditLogUI -> AuditLogController : exportAuditTrail("CSV")
    activate AuditLogController
    AuditLogController -> ExtDB : generateExportBundle("CSV")
    activate ExtDB
    ExtDB --> AuditLogController : exportFile
    deactivate ExtDB
    AuditLogController --> AuditLogUI : exportFile
    deactivate AuditLogController
    AuditLogUI --> Staff : showExportConfirmation()
    deactivate AuditLogUI
end

deactivate Staff
@enduml
