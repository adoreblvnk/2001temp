@startuml ssd_17
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam sequence {
    ParticipantBorderColor #1E3A8A
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #1E3A8A
    LifeLineBackgroundColor #FFFFFF
    ArrowColor #1E3A8A
    ActorBorderColor #1E3A8A
    ActorBackgroundColor #EFF6FF
}

title SSD-17 : Review Labor Compliance & Workload

actor "Manager" as Manager
participant ":ManagerDashboardUI" as UI
participant ":ComplianceController" as ComplianceController
participant ":Schedule" as Schedule
participant ":Teacher" as Teacher
participant ":AuditLog" as AuditLog

Manager -> UI : openLaborCompliancePanel()
activate Manager
activate UI
UI -> ComplianceController : checkWeeklyHours(weekId)
activate ComplianceController

ComplianceController -> Schedule : getActiveTeachers(weekId)
activate Schedule
Schedule --> ComplianceController : List<Teacher>
deactivate Schedule

loop for each teacher
    ComplianceController -> Teacher : calculateWeeklyWorkload()
    activate Teacher
    Teacher --> ComplianceController : weeklyHours : float
    deactivate Teacher
    ComplianceController -> ComplianceController : checkStatutoryOvertime(weeklyHours)
end

ComplianceController --> UI : ComplianceReport(compliantStaff, warningStaff)
deactivate ComplianceController
UI --> Manager : ComplianceDashboardView

Manager -> UI : inspectDailyDistribution(teacherId)
UI -> ComplianceController : checkWeeklyHours(weekId)
activate ComplianceController
ComplianceController --> UI : DailyDistributionView
deactivate ComplianceController
UI --> Manager : DailyDistributionView

opt no staff exceeds 12 daily hours
    Manager -> UI : submitComplianceSignOff(weekId)
    UI -> ComplianceController : auditStatutoryLaborCompliance()
    activate ComplianceController
    ComplianceController -> AuditLog : logAction(managerId, "COMPLIANCE_SIGN_OFF", weekId)
    activate AuditLog
    deactivate AuditLog
    ComplianceController --> UI : VerificationSnapshot
    deactivate ComplianceController
    UI --> Manager : ConfirmationView
end

opt instructor in advisory overtime tier (40.0h - 44.0h)
    UI --> Manager : AdvisoryOvertimeReviewModal
    Manager -> UI : reviewLoggedOverrideJustification(teacherId)
    UI -> ComplianceController : checkWeeklyHours(weekId)
    activate ComplianceController
    ComplianceController -> AuditLog : logAction(managerId, "AUDIT_ADVISORY_OVERTIME", "Verified override for: " + teacherId)
    activate AuditLog
    deactivate AuditLog
    ComplianceController --> UI : AuditConfirmed
    deactivate ComplianceController
    UI --> Manager : AdvisoryAuditConfirmedView
end

deactivate UI
deactivate Manager

@enduml
