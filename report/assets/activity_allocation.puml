@startuml activity_allocation
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam ranksep 40
skinparam nodesep 30
skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    ArrowColor #1E3A8A
    DiamondBorderColor #1E3A8A
    DiamondBackgroundColor #FFFFFF
}

|Manager|
start
:Navigate to Weekly Allocation Interface;
:Select target week and student lesson slot
(Unassigned or Confirmed);

|System|
:Retrieve lesson parameters
(Instrument, Student, Duration);

:Filter candidate teachers to those certified
for the lesson instrument
(uncertified teachers are never listed);
:Query candidate availability, running workloads,
preferences, and studio reservations;
:Render allocation matrix
(displaying up to 3 certified candidate teachers side-by-side);

|Manager|
:Select candidate teacher;

|System|
:Restrict studio picker to instrument-compatible studios
(Drums: Studio 5 only; incompatible studios disabled);

|Manager|
:Select eligible studio and 30-min time slot;

|System|
repeat
    :Validate Dynamic Constraints
    (studio unoccupied, teacher available,
    continuous teaching block <= 4.0h);
    backward:Display dynamic validation error
    ("Room collision", "Teacher unavailable", or "Fatigue limit");
    |Manager|
    :Adjust time slot or candidate selection;
repeat while (Dynamic constraints satisfied?) is ([no - Dynamic Constraint Violation]) not ([yes - All Checks Pass])

|System|
:Calculate projected weekly workload
(including +0.5h for current lesson);

if (Projected weekly workload > 40.0h?) then ([yes - Workload Exceeds 40h])
    |Manager|
    if (Projected weekly workload > 44.0h?) then ([yes - Statutory Cap (>44.0h)])
        |System|
        :Display statutory compliance block:
        "Statutory 44.0h ceiling reached —
        assignment strictly barred under Employment Act";
        |Manager|
        :Selection barred; re-select another candidate;
        stop
    else ([no - Advisory Tier (40.5h - 44.0h)])
        :Review advisory notification:
        "Workload exceeds 40h guideline";
        :Confirm managerial soft-warning override
        with logged justification;
    endif
else ([no - Nominal Workload <= 40.0h])
endif

|System|
:Assign lesson to teacher and studio
(set lesson status to "Confirmed");
:Increment teacher weekly and
monthly workload by 0.5h;
:Persist assignment in database;
:Append immutable transaction
record to Audit Log;

|Manager|
:Display updated weekly schedule
grid with confirmed allocation;
stop
@enduml
