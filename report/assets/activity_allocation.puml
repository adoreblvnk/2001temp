@startuml activity_allocation
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam ranksep 40
skinparam nodesep 30
skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    ArrowColor #1E3A8A
    DiamondBorderColor #1E3A8A
    DiamondBackgroundColor #FFFFFF
}

|Manager|
start
:Navigate to Weekly Allocation Interface;
:Select target week and student lesson slot
(Unassigned or Confirmed);

|System|
:Retrieve lesson parameters
(Instrument, Student, Timeslot, Duration);

repeat
    |System|
    :Filter candidate teachers to those certified
    for the lesson instrument, available for the timeslot,
    within the 4.0h continuous teaching limit,
    and with projected weekly workload <= 44.0h;
    :Render allocation matrix
    (up to 3 eligible candidate teachers side-by-side);

    |Manager|
    :Select candidate teacher;

    |System|
    :Restrict studio picker to studios that are
    instrument-compatible (Drums: Studio 5 only),
    unoccupied, and not under maintenance
    for the timeslot (others disabled);

    |Manager|
    :Select eligible studio;

    |System|
    :Re-validate selection against current schedule;
    backward:Display "Allocation Conflict:
    Selection no longer available";
repeat while (Selection still valid?) is ([no - Concurrent booking]) not ([yes])

|System|
:Calculate projected weekly workload
(including +0.5h for current lesson);

if (Projected weekly workload > 40.0h?) then ([yes - Advisory Tier (40.5h - 44.0h)])
    |Manager|
    :Review advisory notification:
    "Workload exceeds 40h guideline";
    :Confirm managerial soft-warning override
    with logged justification;
else ([no - Nominal Workload <= 40.0h])
endif

|System|
:Assign lesson to teacher and studio
(set lesson status to "Confirmed");
:Increment teacher weekly and
monthly workload by 0.5h;
:Persist assignment in database;
:Append immutable transaction
record to Audit Log;

|Manager|
:Display updated weekly schedule
grid with confirmed allocation;
stop
@enduml
