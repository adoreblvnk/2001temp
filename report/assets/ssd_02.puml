@startuml ssd_02
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam sequence {
    ParticipantBorderColor #1E3A8A
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #1E3A8A
    LifeLineBackgroundColor #FFFFFF
    ArrowColor #1E3A8A
    ActorBorderColor #1E3A8A
    ActorBackgroundColor #EFF6FF
}

title SSD-02 : Allocate Weekly Teaching Job

actor "Manager" as M
participant ":AllocationUI" as UI
participant ":AllocationController" as AC
participant ":ConflictValidator" as CV
participant ":Schedule" as S
participant ":Studio" as St
participant ":Teacher" as T
participant ":Lesson" as L
participant ":AuditLog" as AL

M -> UI : selectJobAllocation(lessonId, teacherId, studioId, timeSlot)
activate UI
UI -> AC : allocateWeeklyJob(lessonId, teacherId, studioId, timeSlot)
activate AC

AC -> CV : validateAllocationRules(teacher, studio, timeSlot)
activate CV
CV -> St : hasDrumKitInstalled()
activate St
St --> CV : isDrumRoom : Boolean
deactivate St
CV -> St : isOccupied(timeSlot)
activate St
St --> CV : roomOccupied : Boolean
deactivate St
CV -> St : isUnderMaintenanceWindow(timeSlot)
activate St
St --> CV : underMaintenance : Boolean
deactivate St
CV -> T : hasInstrumentQualification(instrument)
activate T
T --> CV : isQualified : Boolean
deactivate T
CV -> T : isAvailable()
activate T
T --> CV : isFree : Boolean
deactivate T
CV -> CV : checkContinuousTeachingLimit(teacher, timeSlot)
activate CV
deactivate CV
CV --> AC : ValidationResult
deactivate CV

alt validationResult.isValid == true
    alt teacher weeklyHours + 0.5 > 44.0h
        AC --> UI : displayStatutoryCapBlock()
        UI --> M : statutory 44h block modal
    else teacher weeklyHours + 0.5 > 40.0h
        AC --> UI : promptOverCapacityWarningModal()
        M -> UI : confirmManagerialOverride(justification)
        UI -> AC : submitManagerialOverride(justification)
        AC -> L : assignTeacher(teacher)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> L : assignStudio(studio)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> L : transitionStatus(Confirmed)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> S : addLesson(lesson)
        activate S
        S --> AC : Boolean
        deactivate S
        AC -> AL : logAction(managerId, "ALLOCATE_JOB", lessonId)
        activate AL
        deactivate AL
        AC --> UI : allocationSuccess(lessonId)
        UI -> UI : renderUpdatedScheduleGrid()
        UI --> M : updated schedule view
    else nominal workload <= 40.0h
        AC -> L : assignTeacher(teacher)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> L : assignStudio(studio)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> L : transitionStatus(Confirmed)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> S : addLesson(lesson)
        activate S
        S --> AC : Boolean
        deactivate S
        AC -> AL : logAction(managerId, "ALLOCATE_JOB", lessonId)
        activate AL
        deactivate AL
        AC --> UI : allocationSuccess(lessonId)
        UI -> UI : renderUpdatedScheduleGrid()
        UI --> M : updated schedule view
    end
else validationResult.isValid == false
    AC --> UI : showValidationError(errorMessage)
    UI --> M : conflict error modal
end

deactivate AC
deactivate UI
@enduml
