@startuml ssd_02
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam sequence {
    ParticipantBorderColor #1E3A8A
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #1E3A8A
    LifeLineBackgroundColor #FFFFFF
    ArrowColor #1E3A8A
    ActorBorderColor #1E3A8A
    ActorBackgroundColor #EFF6FF
}

title SSD-02 : Allocate Weekly Teaching Job

actor "Manager" as M
participant ":AllocationUI" as UI
participant ":AllocationController" as AC
participant ":ConflictValidator" as CV
participant ":Schedule" as S
participant ":Studio" as St
participant ":Teacher" as T
participant ":Lesson" as L
participant ":AuditLog" as AL


M -> UI : selectLessonSlot(lessonId)
activate UI
UI -> AC : getAllocationOptions(lessonId)
activate AC
AC -> CV : findEligibleCandidates(instrument, timeSlot, weekId)
activate CV
CV -> T : hasInstrumentQualification(instrument)
activate T
T --> CV : isQualified : Boolean
deactivate T
CV -> T : isAvailable()
activate T
T --> CV : isFree : Boolean
deactivate T
CV -> CV : checkContinuousTeachingLimit(teacher, timeSlot)
activate CV
deactivate CV
CV -> T : calculateWeeklyWorkload()
activate T
T --> CV : currentHours : float
deactivate T
CV --> AC : List<Teacher> (certified, available, <= 4.0h block, projected <= 44.0h)
deactivate CV
AC -> CV : findEligibleStudios(instrument, timeSlot)
activate CV
CV -> St : hasDrumKitInstalled()
activate St
St --> CV : isDrumRoom : Boolean
deactivate St
CV -> St : isOccupied(timeSlot)
activate St
St --> CV : roomOccupied : Boolean
deactivate St
CV -> St : isUnderMaintenanceWindow(timeSlot)
activate St
St --> CV : underMaintenance : Boolean
deactivate St
CV --> AC : List<Studio> (compatible, unoccupied, no maintenance)
deactivate CV
AC --> UI : AllocationOptions(candidates, eligibleStudios)
deactivate AC
UI --> M : candidate panel and filtered studio picker
deactivate UI


M -> UI : selectJobAllocation(lessonId, teacherId, studioId)
activate UI
UI -> AC : allocateWeeklyJob(lessonId, teacherId, studioId)
activate AC


AC -> CV : validateAllocationRules(teacher, studio, timeSlot)
activate CV
CV -> St : isOccupied(timeSlot)
activate St
St --> CV : roomOccupied : Boolean
deactivate St
CV -> St : isUnderMaintenanceWindow(timeSlot)
activate St
St --> CV : underMaintenance : Boolean
deactivate St
CV -> T : isAvailable()
activate T
T --> CV : isFree : Boolean
deactivate T
CV -> CV : checkContinuousTeachingLimit(teacher, timeSlot)
activate CV
deactivate CV
CV --> AC : ValidationResult
deactivate CV

alt validationResult.isValid == true
    alt teacher weeklyHours + 0.5 > 40.0h
        AC --> UI : promptOverCapacityWarningModal()
        M -> UI : confirmManagerialOverride(justification)
        UI -> AC : submitManagerialOverride(justification)
        AC -> L : assignTeacher(teacher)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> L : assignStudio(studio)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> L : transitionStatus(Confirmed)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> S : addLesson(lesson)
        activate S
        S --> AC : Boolean
        deactivate S
        AC -> AL : logAction(managerId, "ALLOCATE_JOB_OVERRIDE", lessonId)
        activate AL
        deactivate AL
        AC --> UI : allocationSuccess(lessonId)
        UI --> M : updated schedule view
    else nominal workload <= 40.0h
        AC -> L : assignTeacher(teacher)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> L : assignStudio(studio)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> L : transitionStatus(Confirmed)
        activate L
        L --> AC : Boolean
        deactivate L
        AC -> S : addLesson(lesson)
        activate S
        S --> AC : Boolean
        deactivate S
        AC -> AL : logAction(managerId, "ALLOCATE_JOB", lessonId)
        activate AL
        deactivate AL
        AC --> UI : allocationSuccess(lessonId)
        UI --> M : updated schedule view
    end
else validationResult.isValid == false
    AC --> UI : showValidationError("Allocation Conflict: Selection no longer available")
    UI --> M : conflict modal and refreshed options
end

deactivate AC
deactivate UI
@enduml
